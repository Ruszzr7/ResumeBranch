# Optional multi-user self-hosted profile
# Copy to .env.multi_user. Do not commit the real file.

APP_MODE=multi_user
HOST=0.0.0.0
PORT=8000

# Generate a private random value with at least 32 characters.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# The account is created or promoted to administrator on container startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Use URL-safe values because MYSQL_PASSWORD is embedded in DATABASE_URL.
MYSQL_DATABASE=resume_assistant
MYSQL_USER=resume_app
MYSQL_PASSWORD=replace-with-a-url-safe-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

# Leave empty for same-origin Nginx deployment. Use a comma-separated allowlist
# only when the frontend is hosted on another trusted origin.
CORS_ALLOW_ORIGINS=

LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_PROFILE_PATH=/app/data/llm_profiles.json
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash
TAVILY_API_KEY=

SOURCE_DOCUMENT_DIR=/app/data/source_documents
AGENT_CHECKPOINTER_ENABLED=true
AGENT_CHECKPOINT_DB_PATH=/app/data/langgraph_checkpoints.sqlite
AGENT_CHECKPOINT_RETENTION_DAYS=30
INTERVIEW_HARNESS_ENABLED=true
INTERVIEW_HARNESS_ROLLOUT_PERCENT=100
INTERVIEW_HARNESS_SHADOW=false
