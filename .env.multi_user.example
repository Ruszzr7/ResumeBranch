# Windows native multi-user profile
# Copy to .env.multi_user. Do not commit the real file.

APP_MODE=multi_user
HOST=127.0.0.1
PORT=8000

# Native Windows may set a complete SQLAlchemy URL here. When left empty, the
# launcher builds it from MYSQL_HOST/PORT/DATABASE/USER/PASSWORD below.
DATABASE_URL=

# Generate a private random value with at least 32 characters.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# The administrator may use an email or a dedicated non-email account name.
# Ordinary users must register and sign in with email addresses.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# The native launcher URL-encodes MYSQL_PASSWORD when it builds DATABASE_URL.
MYSQL_DATABASE=resume_assistant
MYSQL_USER=resume_app
MYSQL_PASSWORD=replace-with-a-url-safe-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Leave empty for same-origin Nginx deployment. Use a comma-separated allowlist
# only when the frontend is hosted on another trusted origin.
CORS_ALLOW_ORIGINS=

LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_PROFILE_PATH=data/llm_profiles.json
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash

SOURCE_DOCUMENT_DIR=data/source_documents
