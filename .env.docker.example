# Docker Compose multi-user profile.
# Copy to .env.docker and replace every placeholder before starting.
# Do not commit the real file.

APP_MODE=multi_user
HOST=0.0.0.0
PORT=8000

# Generate a private random value with at least 32 characters.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# The administrator may use an email or a dedicated non-email account name.
# Ordinary users must register and sign in with email addresses.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# The Compose file builds DATABASE_URL from these values. Keep the database
# password URL-safe because it is embedded in that connection URL.
MYSQL_DATABASE=resume_assistant
MYSQL_USER=resume_app
MYSQL_PASSWORD=replace-with-a-url-safe-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Leave empty for same-origin access through the frontend Nginx container.
CORS_ALLOW_ORIGINS=

LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_PROFILE_PATH=/app/data/llm_profiles.json
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash

SOURCE_DOCUMENT_DIR=/app/data/source_documents
