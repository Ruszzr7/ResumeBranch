# ResumeBranch local environment template
# Copy to .env and keep the real file out of Git.

# Application mode: local disables login/register/admin; multi_user keeps them.
APP_MODE=local
LOCAL_USER_EMAIL=local@localhost

# Authentication is disabled in local mode. See .env.multi_user.example for
# JWT and administrator settings used by the optional multi-user profile.

# LLM (may remain empty until AI features are enabled)
# These values seed the first provider profile. Later changes are stored in
# data/llm_profiles.json so each provider can keep an independent API Key.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_PROFILE_PATH=./data/llm_profiles.json
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash

# Optional private storage for the immutable PDF/image retained after import.
# Defaults to data/source_documents and should live on a persistent volume.
SOURCE_DOCUMENT_DIR=./data/source_documents

# Embedded local database. The file remains under data/ after shutdown/restart.
DATABASE_URL=sqlite:///./data/resumebranch.db

# Local exports are retained here instead of being duplicated in browser downloads.
LOCAL_EXPORT_DIR=./output/resumes

# Optional explicit Chrome/Edge/Chromium executable path for PDF export.
# RESUME_PDF_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe

# Local server
HOST=127.0.0.1
PORT=8000
DOMAIN=localhost
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
