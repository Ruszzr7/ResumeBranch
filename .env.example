# DeepAgents local environment template
# Copy to .env and keep the real file out of Git.

# Application mode: local disables login/register/admin; multi_user keeps them.
APP_MODE=local
LOCAL_USER_EMAIL=local@localhost

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=replace-with-a-random-local-password

# LLM (may remain empty until AI features are enabled)
# These values seed the first provider profile. Later changes are stored in
# data/llm_profiles.json so each provider can keep an independent API Key.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_PROFILE_PATH=./data/llm_profiles.json
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash
TAVILY_API_KEY=

# Durable LangGraph workflow control state. This SQLite file is appropriate
# for the current single-backend deployment and is persisted by ./data volume.
AGENT_CHECKPOINTER_ENABLED=true
AGENT_CHECKPOINT_DB_PATH=data/langgraph_checkpoints.sqlite
# Whole control threads older than this are removed; resume/JD/business memory are not.
AGENT_CHECKPOINT_RETENTION_DAYS=30

# Structured resume diagnosis/interview path. Rollout is stable per user+task.
INTERVIEW_HARNESS_ENABLED=true
INTERVIEW_HARNESS_ROLLOUT_PERCENT=100
# Logs only deterministic routing projection; it does not double LLM cost.
INTERVIEW_HARNESS_SHADOW=false

# MySQL 8 local database
DATABASE_URL=mysql+pymysql://resume_app:replace-with-url-safe-password@127.0.0.1:3306/resume_assistant?charset=utf8mb4

# Local server
HOST=127.0.0.1
PORT=8000
DOMAIN=localhost
WEASYPRINT_DLL_DIRECTORIES=C:\resume-tools\msys64\ucrt64\bin
