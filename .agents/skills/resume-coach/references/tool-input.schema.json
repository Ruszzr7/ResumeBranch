{
  "$defs": {
    "CoachProposal": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "resume_operations": {
          "items": {
            "$ref": "#/$defs/ResumeEditOperation"
          },
          "title": "Resume Operations",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "resume_operations"
      ],
      "title": "CoachProposal",
      "type": "object"
    },
    "EvidenceCandidate": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "source_quote": {
          "title": "Source Quote",
          "type": "string"
        },
        "section": {
          "default": "",
          "title": "Section",
          "type": "string"
        },
        "dimension": {
          "default": "",
          "title": "Dimension",
          "type": "string"
        }
      },
      "required": [
        "claim",
        "source_quote"
      ],
      "title": "EvidenceCandidate",
      "type": "object"
    },
    "ResumeEditOperation": {
      "additionalProperties": false,
      "description": "模型提供的一条标准化修改操作。",
      "properties": {
        "op": {
          "description": "操作类型。",
          "enum": [
            "set",
            "replace",
            "append",
            "insert",
            "remove",
            "move"
          ],
          "title": "Op",
          "type": "string"
        },
        "path": {
          "description": "契约定义的最小可写路径。",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set、replace、append 或 insert 的目标值。",
          "title": "Value"
        },
        "index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "insert 或列表 remove 的目标索引。",
          "title": "Index"
        },
        "from_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "move 的原始索引。",
          "title": "From Index"
        },
        "to_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "move 的目标索引。",
          "title": "To Index"
        },
        "target_semantic_role": {
          "anyOf": [
            {
              "enum": [
                "tech_stack",
                "introduction",
                "responsibilities",
                "generic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "内容块的稳定语义角色，仅用于 content_blocks。",
          "title": "Target Semantic Role"
        }
      },
      "required": [
        "op",
        "path"
      ],
      "title": "ResumeEditOperation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "operation": {
      "enum": [
        "offer_start",
        "dismiss_start",
        "start",
        "update",
        "offer_preview",
        "handoff_to_edit",
        "complete_issue",
        "exit"
      ],
      "title": "Operation",
      "type": "string"
    },
    "issue_id": {
      "default": "",
      "title": "Issue Id",
      "type": "string"
    },
    "problem": {
      "default": "",
      "title": "Problem",
      "type": "string"
    },
    "entry": {
      "default": "",
      "enum": [
        "",
        "explicit_request",
        "accepted_offer"
      ],
      "title": "Entry",
      "type": "string"
    },
    "offer_id": {
      "default": "",
      "title": "Offer Id",
      "type": "string"
    },
    "evidence_candidates": {
      "items": {
        "$ref": "#/$defs/EvidenceCandidate"
      },
      "title": "Evidence Candidates",
      "type": "array"
    },
    "supersede_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Supersede Evidence Ids",
      "type": "array"
    },
    "conclusions": {
      "items": {
        "type": "string"
      },
      "title": "Conclusions",
      "type": "array"
    },
    "open_questions": {
      "items": {
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoachProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "approval_quote": {
      "default": "",
      "title": "Approval Quote",
      "type": "string"
    },
    "result": {
      "default": "",
      "title": "Result",
      "type": "string"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    },
    "completion_status": {
      "default": "completed",
      "enum": [
        "completed",
        "skipped"
      ],
      "title": "Completion Status",
      "type": "string"
    },
    "next_issue_id": {
      "default": "",
      "title": "Next Issue Id",
      "type": "string"
    },
    "next_problem": {
      "default": "",
      "title": "Next Problem",
      "type": "string"
    }
  },
  "required": [
    "operation"
  ],
  "title": "ResumeCoachToolInput",
  "type": "object"
}
