{
  "$defs": {
    "CoachIssue": {
      "additionalProperties": false,
      "properties": {
        "problem": {
          "default": "",
          "title": "Problem",
          "type": "string"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "completed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRecord"
          },
          "title": "Evidence",
          "type": "array"
        },
        "conclusions": {
          "items": {
            "type": "string"
          },
          "title": "Conclusions",
          "type": "array"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "title": "Open Questions",
          "type": "array"
        },
        "pending_preview_offer": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreviewOffer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "result": {
          "default": "",
          "title": "Result",
          "type": "string"
        }
      },
      "title": "CoachIssue",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "source_quote": {
          "title": "Source Quote",
          "type": "string"
        },
        "section": {
          "default": "",
          "title": "Section",
          "type": "string"
        },
        "dimension": {
          "default": "",
          "title": "Dimension",
          "type": "string"
        },
        "source_request_id": {
          "title": "Source Request Id",
          "type": "string"
        },
        "verified_at": {
          "title": "Verified At",
          "type": "string"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "superseded"
          ],
          "title": "Status",
          "type": "string"
        },
        "superseded_by_request_id": {
          "default": "",
          "title": "Superseded By Request Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "claim",
        "source_quote",
        "source_request_id",
        "verified_at"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "PreviewOffer": {
      "additionalProperties": false,
      "properties": {
        "offer_id": {
          "title": "Offer Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "resume_operations": {
          "items": {
            "$ref": "#/$defs/ResumeEditOperation"
          },
          "title": "Resume Operations",
          "type": "array"
        },
        "source_content_digest": {
          "title": "Source Content Digest",
          "type": "string"
        },
        "status": {
          "enum": [
            "offered",
            "authorized",
            "preview_generated",
            "noop",
            "applied",
            "partially_applied",
            "rejected",
            "invalidated",
            "undone"
          ],
          "title": "Status",
          "type": "string"
        },
        "revision_id": {
          "default": "",
          "title": "Revision Id",
          "type": "string"
        },
        "applied_at": {
          "default": "",
          "title": "Applied At",
          "type": "string"
        }
      },
      "required": [
        "offer_id",
        "summary",
        "resume_operations",
        "source_content_digest",
        "status"
      ],
      "title": "PreviewOffer",
      "type": "object"
    },
    "ResumeEditOperation": {
      "additionalProperties": false,
      "description": "模型提供的一条标准化修改操作。",
      "properties": {
        "op": {
          "description": "操作类型。",
          "enum": [
            "set",
            "replace",
            "append",
            "insert",
            "remove",
            "move"
          ],
          "title": "Op",
          "type": "string"
        },
        "path": {
          "description": "契约定义的最小可写路径。",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set、replace、append 或 insert 的目标值。",
          "title": "Value"
        },
        "index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "insert 或列表 remove 的目标索引。",
          "title": "Index"
        },
        "from_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "move 的原始索引。",
          "title": "From Index"
        },
        "to_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "move 的目标索引。",
          "title": "To Index"
        },
        "target_semantic_role": {
          "anyOf": [
            {
              "enum": [
                "tech_stack",
                "introduction",
                "responsibilities",
                "generic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "内容块的稳定语义角色，仅用于 content_blocks。",
          "title": "Target Semantic Role"
        }
      },
      "required": [
        "op",
        "path"
      ],
      "title": "ResumeEditOperation",
      "type": "object"
    },
    "StartOffer": {
      "additionalProperties": false,
      "properties": {
        "offer_id": {
          "title": "Offer Id",
          "type": "string"
        },
        "problem": {
          "title": "Problem",
          "type": "string"
        },
        "source_request_id": {
          "title": "Source Request Id",
          "type": "string"
        },
        "status": {
          "const": "offered",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "offer_id",
        "problem",
        "source_request_id",
        "status"
      ],
      "title": "StartOffer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "active": {
      "default": false,
      "title": "Active",
      "type": "boolean"
    },
    "entry": {
      "default": "",
      "enum": [
        "",
        "explicit_command",
        "explicit_request",
        "accepted_offer"
      ],
      "title": "Entry",
      "type": "string"
    },
    "agenda": {
      "items": {
        "type": "string"
      },
      "title": "Agenda",
      "type": "array"
    },
    "current_issue_id": {
      "default": "",
      "title": "Current Issue Id",
      "type": "string"
    },
    "issues": {
      "additionalProperties": {
        "$ref": "#/$defs/CoachIssue"
      },
      "title": "Issues",
      "type": "object"
    },
    "pending_start_offer": {
      "anyOf": [
        {
          "$ref": "#/$defs/StartOffer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "updated_at": {
      "default": "",
      "title": "Updated At",
      "type": "string"
    }
  },
  "title": "CoachState",
  "type": "object"
}
